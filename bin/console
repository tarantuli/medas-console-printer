<?php

use Medas\ConsolePrinter\CommandProcessor;

require_once __DIR__ . '/../bootstrap.php';

$arguments = $argv;

if (str_ends_with($arguments[0], 'console')) {
    array_shift($arguments);
}

try {
    service(CommandProcessor::class)->process($arguments);
}
catch (\Throwable $exception) {
    echo "\n× {$exception->getMessage()}\n\n";
}
